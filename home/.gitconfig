[push]
	default = simple
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[commit]
	template = .stCommitMsg
	gpgsign = true
[credential]
	helper = osxkeychain
[merge]
	; ff = false
[pull]
	ff = only
[alias]
	a = add
	aa = add .
	bd = branch -d
	bm = branch -M
	br = branch
	bv = branch -vv
	c = commit
	ca = commit --amend
	cb = switch -c
	ch = switch
	cl = clone
	cm = commit -m
	d = icdiff
	dev = switch develop
	ds = icdiff --staged
	dt = -c diff.external=difft diff
	dts = -c diff.external=difft diff --staged
	h = help
	lf = log --pretty=fuller
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	m = merge
	mas = !git switch $(basename $(git symbolic-ref refs/remotes/origin/HEAD --short))
	md = merge develop
	mf = merge --ff-only
	mm = !git merge $(basename $(git symbolic-ref refs/remotes/origin/HEAD --short))
	mom = !git merge $(git symbolic-ref refs/remotes/origin/HEAD --short)
	n = checkout -b
	nb = checkout -b
	p = push
	pa = push --all
	pf = push --force-with-lease --force-if-includes
	pl = pull
	s = status --short --branch
	sd = "!git d stash@{$1}~ stash@{$1} #"
	sl = stash list
	st = status
	ta = tag -a
	top = rev-parse --show-toplevel
	z = "!before=$(git rev-parse HEAD) && canonical=$(basename $(git symbolic-ref refs/remotes/origin/HEAD --short)) && branch=${GIT_CANONICAL_BRANCH:-$canonical} && git switch \"$branch\" && git fetch -p --all && { if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then git pull; else git merge --ff-only origin/HEAD; fi; } && { git diff --quiet \"$before\" HEAD -- Gemfile Gemfile.lock || bundle install; } && git branch -vv | awk '/: gone]/ { if($1==\"+\") { print $2 } else { print $1 } }' | xargs -r git branch -d"
[gpg]
	program = gpg
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
[includeIf "hasconfig:remote.*.url:git@github.com:*/*"]
	path = ~/.gitconfig.github
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.gitconfig.github
[branch]
	autoSetupMerge = simple
